---

{% set currentMonth = "" %}

{% for event in greenroomCalendar %}

  {% if event.monthHeading != currentMonth %}
    <h2>{{ event.monthHeading }}</h2>
    {% set currentMonth = event.monthHeading %}
  {% endif %}

  <article class="calendar-event">
    <div class="calendar-date">
      <strong>{{ event.day }}</strong>
      <small>{{ event.weekday }}</small>
    </div>

    <div class="calendar-details">
      <h3>{{ event.summary }}</h3>

      {% if event.time %}
        <small>{{ event.time }}</small>
      {% endif %}

      {% if event.location %}
        <p><small>{{ event.location }}</small></p>
      {% endif %}
    </div>
  </article>

{% endfor %}
